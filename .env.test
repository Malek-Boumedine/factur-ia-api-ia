# Valeurs factices pour la CI (chargées par tests/conftest.py si aucun .env local).
APP_NAME="Factur-IA API IA Test"
ENVIRONNEMENT="test"
DEBUG="True"
API_HOST="localhost"
API_PORT="8001"
SECRET_OCR_TOKEN="dummy-ci-ocr-not-a-real-token"   # pragma: allowlist secret
DATA_API_BASE_URL="http://localhost:8000"
GROQ_API_KEY="azertyuiop123456798"        # pragma: allowlist secret
# Monitoring désactivé en test : c'est déjà le défaut, mais l'écrire ici protège
# la suite d'une variable d'environnement traînant sur le poste du développeur
# (chargé avec override=True par conftest.py). Les tests du monitoring
# l'activent eux-mêmes, sur un store temporaire.
MLFLOW_ENABLED="False"
# Même logique pour l'observabilité OpenTelemetry : désactivée explicitement,
# les tests de télémétrie l'activent eux-mêmes sur des apps dédiées.
OTEL_ENABLED="False"
OTEL_METRICS_ENABLED="False"
