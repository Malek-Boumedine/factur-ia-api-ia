# === Configuration de l'API IA (copier en .env et renseigner) ===

# --- Global ---
APP_NAME="Factur-IA API IA"
ENVIRONNEMENT="dev"                 # dev | test | prod
DEBUG="True"

# --- API (ce service) ---
API_HOST="localhost"
API_PORT="8001"                     # distinct de l'API data (8000) en local

# --- Sécurité / contrat inter-services ---
# MÊME valeur que l'API data. Générer via : openssl rand -hex 32
SECRET_OCR_TOKEN="changeme-shared-ocr-token"   # pragma: allowlist secret

# --- Callback vers l'API data ---
DATA_API_BASE_URL="http://localhost:8000"      # callback = base + /documents/webhook/ocr
HTTP_TIMEOUT_SECONDS="30"
HTTP_MAX_RETRIES="2"

# --- LLM Groq ---
GROQ_API_KEY="changeme-groq-api-key"           # pragma: allowlist secret
GROQ_MODEL="openai/gpt-oss-120b"               # supporte les structured outputs stricts (Groq)
GROQ_TIMEOUT_SECONDS="60"

# --- OCR / extraction ---
OCR_LANGUAGES="fr,en"
EASYOCR_GPU="False"
MAX_UPLOAD_SIZE_MB="10"

# --- CORS ---
CORS_ORIGINS="*"                    # à restreindre avant la prod

# --- Observabilité — OpenTelemetry ---
# Deux interrupteurs indépendants, désactivés par défaut : sans eux, rien n'est
# instrumenté (local et CI inchangés). OTEL_ENABLED = traces (export OTLP) ;
# OTEL_METRICS_ENABLED = métriques (endpoint /metrics au format Prometheus,
# dont les métriques de qualité d'extraction — NE PAS activer tel quel en
# production : /metrics ne doit pas être public, et sur Cloud Run avec
# scale-to-zero les métriques en mémoire sont perdues à chaque recyclage
# d'instance — limite du modèle pull, un export push viendra avec la stack
# d'observabilité mutualisée).
# Les autres variables suivent les conventions standard OpenTelemetry.
# NE JAMAIS définir les variables OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_* :
# la capture de headers exposerait X-OCR-Secret-Token et Authorization (clé Groq).
OTEL_ENABLED="False"
OTEL_METRICS_ENABLED="False"
OTEL_SERVICE_NAME="factur-ia-api-ia"
OTEL_EXPORTER_OTLP_ENDPOINT="URL du collector OTLP/HTTP (ex : http://localhost:4318)"
# exporter : "otlp" (défaut) ou "console" (vérification locale sans collector)
OTEL_TRACES_EXPORTER="otlp"
# échantillonnage (optionnel, défaut : tout tracer) — ex en production :
# OTEL_TRACES_SAMPLER="parentbased_traceidratio"
# OTEL_TRACES_SAMPLER_ARG="0.1"
# conventions sémantiques HTTP stables (requises pour le label http.route des
# métriques ; défaut "http" posé par le code, surchargeable ici) :
# OTEL_SEMCONV_STABILITY_OPT_IN="http"

# --- Monitoring de la qualité d'extraction (MLflow) ---
# Désactivé par défaut : sans activation explicite, rien n'est tracé et la
# bibliothèque mlflow n'est même pas importée (local et CI inchangés).
# Aucun serveur n'est nécessaire pour ÉCRIRE : le store est un fichier SQLite
# local. Le serveur (`uv run mlflow ui`) ne sert qu'à RELIRE les métriques.
MLFLOW_ENABLED="False"
# Store des runs : fichier SQLite local en développement ; en production, la
# base `mlflow` dédiée sur Cloud SQL MySQL (persistance au recyclage des
# instances Cloud Run) : mysql+pymysql://<user>:<motdepasse>@hote:3306/mlflow
MLFLOW_TRACKING_URI="sqlite:///mlflow.db"
MLFLOW_EXPERIMENT_NAME="factur-ia-extraction"
# Score de confiance sous lequel une extraction est signalée comme dégradée
# (WARNING dans les logs + tag `alerte=true` sur le run, filtrable dans l'UI).
MONITORING_SEUIL_ALERTE="0.7"
