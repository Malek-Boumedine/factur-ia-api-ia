# Fichiers exclus de l'image Docker (jamais copiés par `COPY . .`).

# Secrets et données locales : le .env est fourni au conteneur à l'exécution
# via `env_file` dans le compose, jamais figé dans l'image.
.env
.env.test

# Environnement virtuel et caches Python : recréés dans l'image, inutiles ici.
.venv/
__pycache__/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage

# Base de monitoring MLflow : locale, régénérée au besoin.
mlflow.db
mlruns/

# Tests, données du scraping, logs et sorties d'outillage : rien à faire en
# production (sans effet sur l'image de dev, où le code est monté en volume).
tests/
data/
logs/
graphify-out/

# Poids OCR qui traîneraient à la racine : fournis par un volume.
*.pth
.EasyOCR/

# Git, outillage et documentation de travail.
.git/
.github/
.claude/
docs/
todo*.md
